#include <stdio.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>

struct msg
{
    long type;
    char text[20];
};

int main()
{
    int id;
    struct msg m;

    id = msgget(1234, 0666 | IPC_CREAT);

    m.type = 1;
    strcpy(m.text, "Hello");

    msgsnd(id, &m, sizeof(m.text), 0);
    msgrcv(id, &m, sizeof(m.text), 1, 0);

    printf("%s", m.text);

    return 0;
}
